{
  "name": "@local/liangwen-peak-valley",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Goofy Liang Wenfeng / Liang Wengu price badge in the sidebar footer, driven by the real DeepSeek peak/off-peak schedule.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "pricing",
    "peak",
    "off-peak",
    "rheostat"
  ],
  "author": ""
}
